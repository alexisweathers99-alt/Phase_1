# SURICATA CUSTOM RULESET
# Format: action protocol source_ip source_port -> dest_ip dest_port (options)

alert http any any -> 172.90.0.10 80 (msg:"Ghost_Bear Malware Scanner Detected"; http.user_agent; content:"Ghost_Scanner_v1"; sid:1000002; rev:2;)

# https://f5.com/nginx
alert tcp any any -> 172.90.0.10 80 (msg:"Ghost_Bear Malware Scanner Detected"; content:"Ghost_Scanner_v1"; sid:1000002; rev:1;)
